[Unit]
Description=Local pod commands and activity
Requires=pod-mux.service
After=pod-mux.service

[Service]
User=podshell
Group=podshell
WorkingDirectory=/work
Environment=HOME=/home/podshell
Environment=PMUX_SOCKET=/run/pmux-mux/pmux.sock
Environment=PATH=/opt/pod/bin:/opt/pod/clients/bin:/opt/pod/toolchains/node/bin:/opt/pod/toolchains/rust/bin:/usr/local/bin:/usr/bin:/bin
Environment=CARGO_HOME=/var/cache/pod/cargo
Environment=npm_config_cache=/var/cache/pod/npm
ExecStart=/opt/pod/bin/pmux-mcp --pod-agent --socket /run/pmux-pod/agent.sock --bridge-user pmuxbridge
Restart=on-failure
RestartSec=2
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/podshell /work /var/cache/pod /run/pmux-pod
PrivateTmp=yes
InaccessiblePaths=-/run/credentials/pod-bridge.service -/run/pmux-pod-boot

[Install]
WantedBy=multi-user.target

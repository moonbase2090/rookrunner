#!/bin/sh
# Check formatting of staged Python blobs under src/ and tests/.
# Ruff reads the index blob, not the working tree, so a formatted
# worktree cannot hide an unformatted staged file.

set -u

list=$(mktemp) || exit 1
trap 'rm -f "$list"' EXIT
git diff --cached --name-only --diff-filter=ACMR | grep -E '^(src|tests)/.+\.py$' > "$list" || true
if [ ! -s "$list" ]; then
  exit 0
fi

failed=0
while IFS= read -r path; do
  [ -n "$path" ] || continue
  if ! git show ":$path" | .venv/bin/ruff format --check --stdin-filename "$path"; then
    failed=1
  fi
done < "$list"

if [ "$failed" -ne 0 ]; then
  printf '%s\n' '.venv/bin/ruff format src tests'
  exit 1
fi
